<section class="fh-wrap fh-section" data-reveal>
  <h2 class="fh-section__title fh-section__title--center">{{ 'flubberhomme.testimonials.title' | t }}</h2>
  <div class="fh-card-grid">
    {%- for i in (1..3) -%}
      <div class="fh-testimonial">
        <div class="fh-rating fh-rating--sm">★★★★★</div>
        <p class="fh-testimonial__quote">&ldquo;{{ 'flubberhomme.testimonials.' | append: i | append: '_text' | t }}&rdquo;</p>
        <span class="fh-testimonial__author">— {{ 'flubberhomme.testimonials.' | append: i | append: '_name' | t }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonios",
  "settings": [],
  "presets": [
    { "name": "Testimonios" }
  ]
}
{% endschema %}
