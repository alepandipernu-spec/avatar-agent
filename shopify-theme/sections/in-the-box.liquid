<section class="fh-wrap fh-section fh-section--tight-top" data-reveal>
  <h2 class="fh-section__title">{{ 'flubberhomme.box.title' | t }}</h2>
  <p class="fh-section__sub">{{ 'flubberhomme.box.subtitle' | t }}</p>
  <div class="fh-box-grid">
    <div class="fh-box-grid__frame">
      {%- if section.settings.image_1 != blank -%}
        <img class="fh-box-grid__img" src="{{ section.settings.image_1 | image_url: width: 900 }}" alt="{{ section.settings.image_1.alt | default: 'flubberhomme' | escape }}" loading="lazy">
      {%- else -%}
        <img class="fh-box-grid__img" src="{{ 'box-rosa.png' | asset_url }}" alt="Kit licuadora rosa" loading="lazy">
      {%- endif -%}
    </div>
    <div class="fh-box-grid__frame">
      {%- if section.settings.image_2 != blank -%}
        <img class="fh-box-grid__img" src="{{ section.settings.image_2 | image_url: width: 900 }}" alt="{{ section.settings.image_2.alt | default: 'flubberhomme' | escape }}" loading="lazy">
      {%- else -%}
        <img class="fh-box-grid__img" src="{{ 'box-blanco.png' | asset_url }}" alt="Kit licuadora blanco" loading="lazy">
      {%- endif -%}
    </div>
  </div>
  <div class="fh-box-chips">
    {%- for i in (1..3) -%}
      <span class="fh-box-chip"><span class="fh-box-chip__check">✓</span>{{ 'flubberhomme.box.item_' | append: i | t }}</span>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "En la caja",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Imagen 1 (kit rosa)" },
    { "type": "image_picker", "id": "image_2", "label": "Imagen 2 (kit blanco)" }
  ],
  "presets": [
    { "name": "En la caja" }
  ]
}
{% endschema %}
