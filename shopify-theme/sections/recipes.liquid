<section class="fh-wrap fh-section fh-section--tight-top" data-reveal>
  <h2 class="fh-section__title">{{ 'flubberhomme.recipes.title' | t }}</h2>
  <p class="fh-section__sub">{{ 'flubberhomme.recipes.subtitle' | t }}</p>
  <div class="fh-card-grid">
    {%- assign bgs = 'var(--pink)|var(--mint)|var(--peach)' | split: '|' -%}
    {%- for i in (1..3) -%}
      <div class="fh-recipe" style="background: {{ bgs[forloop.index0] }};">
        <span class="fh-recipe__tag">{{ 'flubberhomme.recipes.' | append: i | append: '_tag' | t }}</span>
        <h3 class="fh-recipe__title">{{ 'flubberhomme.recipes.' | append: i | append: '_name' | t }}</h3>
        <p class="fh-recipe__desc">{{ 'flubberhomme.recipes.' | append: i | append: '_desc' | t }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Recetas",
  "settings": [],
  "presets": [
    { "name": "Recetas" }
  ]
}
{% endschema %}
