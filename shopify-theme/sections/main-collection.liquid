{%- liquid
  assign total_cards = 0
  for product in collection.products
    assign color_option_index = -1
    for option in product.options_with_values
      assign downcased_name = option.name | downcase
      if downcased_name == 'color' or downcased_name == 'colour'
        assign color_option_index = forloop.index0
      endif
    endfor
    if color_option_index != -1 and product.options.size == 1
      assign total_cards = total_cards | plus: product.variants.size
    else
      assign total_cards = total_cards | plus: 1
    endif
  endfor

  assign page_title = section.settings.title
  if page_title == blank
    assign page_title = collection.title
  endif

  assign page_subtitle = collection.description | strip_html
-%}

<div class="fh-wrap" style="padding: clamp(36px,5vw,64px) 0 clamp(56px,7vw,96px);">
  <div class="fh-collection-head">
    <div>
      <h1 class="fh-collection-head__title">{% if page_title != blank %}{{ page_title }}{% else %}{{ 'flubberhomme.collection.title' | t }}{% endif %}</h1>
      <p class="fh-collection-head__sub">{% if page_subtitle != blank %}{{ page_subtitle }}{% else %}{{ 'flubberhomme.collection.subtitle' | t }}{% endif %}</p>
    </div>
    <span class="fh-collection-head__count">{{ 'flubberhomme.collection.count' | t: count: total_cards }}</span>
  </div>

  <div class="product-grid">
    {%- for product in collection.products -%}
      {%- liquid
        assign color_option_index = -1
        for option in product.options_with_values
          assign downcased_name = option.name | downcase
          if downcased_name == 'color' or downcased_name == 'colour'
            assign color_option_index = forloop.index0
          endif
        endfor
        assign has_color_swatches = false
        if color_option_index != -1 and product.options.size == 1
          assign has_color_swatches = true
        endif
      -%}

      {%- if has_color_swatches -%}
        {%- for variant in product.variants -%}
          {%- capture hex -%}{% render 'swatch-hex', name: variant.title %}{%- endcapture -%}
          {%- assign v_image = variant.featured_image | default: product.featured_image -%}
          <div class="product-card">
            <a href="{{ variant.url }}" class="product-card__link">
              <div class="product-card__media">
                {%- if variant.compare_at_price > variant.price -%}
                  {%- assign save_amount = variant.compare_at_price | minus: variant.price -%}
                  {%- assign save_amount_fmt = save_amount | money -%}
                  <span class="product-card__badge">{{ 'flubberhomme.collection.save_badge' | t: amount: save_amount_fmt }}</span>
                {%- elsif product.tags contains 'bestseller' and forloop.first -%}
                  <span class="product-card__badge">{{ 'flubberhomme.bestseller.badge' | t }}</span>
                {%- endif -%}
                <img class="product-card__img" src="{{ v_image | image_url: width: 520 }}" alt="{{ variant.title | escape }}" loading="lazy" width="520" height="520">
              </div>
              <div class="product-card__color-row">
                <span class="product-card__dot" style="background: {{ hex | strip }};"></span>
                <span class="product-card__color-name">{{ variant.title }}</span>
              </div>
              <h3 class="product-card__name">{{ product.title }}</h3>
            </a>
            <div class="product-card__footer">
              <span class="product-card__price">{{ variant.price | money }}</span>
              {%- form 'product', product, class: 'product-card__form' -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <button type="submit" class="btn btn--ink btn--small"{% unless variant.available %} disabled{% endunless %}>{{ 'flubberhomme.collection.add' | t }}</button>
              {%- endform -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign default_variant = product.selected_or_first_available_variant -%}
        <div class="product-card">
          <a href="{{ product.url }}" class="product-card__link">
            <div class="product-card__media">
              {%- if default_variant.compare_at_price > default_variant.price -%}
                {%- assign save_amount = default_variant.compare_at_price | minus: default_variant.price -%}
                {%- assign save_amount_fmt = save_amount | money -%}
                <span class="product-card__badge">{{ 'flubberhomme.collection.save_badge' | t: amount: save_amount_fmt }}</span>
              {%- elsif product.tags contains 'bestseller' -%}
                <span class="product-card__badge">{{ 'flubberhomme.bestseller.badge' | t }}</span>
              {%- endif -%}
              <img class="product-card__img" src="{{ product.featured_image | image_url: width: 520 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="520" height="520">
            </div>
            <h3 class="product-card__name product-card__name--top">{{ product.title }}</h3>
          </a>
          <div class="product-card__footer">
            <span class="product-card__price">{{ default_variant.price | money }}</span>
            {%- form 'product', product, class: 'product-card__form' -%}
              <input type="hidden" name="id" value="{{ default_variant.id }}">
              <button type="submit" class="btn btn--ink btn--small"{% unless default_variant.available %} disabled{% endunless %}>{{ 'flubberhomme.collection.add' | t }}</button>
            {%- endform -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "text", "id": "title", "label": "Título alternativo" }
  ]
}
{% endschema %}
