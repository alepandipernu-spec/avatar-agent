<div class="fh-wrap fh-wrap--narrow" style="padding: clamp(36px,5vw,64px) 0 clamp(56px,7vw,96px);">
  <h1 class="fh-about__title">{{ 'flubberhomme.about.heading' | t }}</h1>
  <p class="fh-about__body">{{ 'flubberhomme.about.body' | t }}</p>

  <div class="fh-about__values">
    <div class="fh-about__value">
      <h3>{{ 'flubberhomme.about.value_1_h' | t }}</h3>
      <p>{{ 'flubberhomme.about.value_1_p' | t }}</p>
    </div>
    <div class="fh-about__value">
      <h3>{{ 'flubberhomme.about.value_2_h' | t }}</h3>
      <p>{{ 'flubberhomme.about.value_2_p' | t }}</p>
    </div>
    <div class="fh-about__value">
      <h3>{{ 'flubberhomme.about.value_3_h' | t }}</h3>
      <p>{{ 'flubberhomme.about.value_3_p' | t }}</p>
    </div>
  </div>

  <div class="fh-about__stats">
    <div class="fh-about__stat">
      <div class="fh-about__stat-n">{{ 'flubberhomme.about.stat_1_n' | t }}</div>
      <div class="fh-about__stat-l">{{ 'flubberhomme.about.stat_1_l' | t }}</div>
    </div>
    <div class="fh-about__stat">
      <div class="fh-about__stat-n">{{ 'flubberhomme.about.stat_2_n' | t }}</div>
      <div class="fh-about__stat-l">{{ 'flubberhomme.about.stat_2_l' | t }}</div>
    </div>
    <div class="fh-about__stat">
      <div class="fh-about__stat-n">{{ 'flubberhomme.about.stat_3_n' | t }}</div>
      <div class="fh-about__stat-l">{{ 'flubberhomme.about.stat_3_l' | t }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Página nosotros",
  "settings": []
}
{% endschema %}
