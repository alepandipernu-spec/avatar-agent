# Server Configuration
PORT=3000
NODE_ENV=development

# Avatar Generation API Keys
OPENAI_API_KEY=your_openai_api_key_here
STABILITY_AI_KEY=your_stability_ai_key_here

# Database (Optional - for storing avatars)
DATABASE_URL=mongodb://localhost:27017/avatar-agent

# File Storage
UPLOAD_DIR=./avatars
MAX_FILE_SIZE=52428800

# 3D Avatar Service
THREE_JS_DEBUG=false

# Advertisement Service
AD_OUTPUT_DIR=./generated/ads
AD_WATERMARK=true

# Logging
LOG_LEVEL=info
